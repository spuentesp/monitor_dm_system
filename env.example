# MONITOR repository environment variables
# Copy this file to .env and fill in your own values.

# =============================================================================
# UI Backend
# =============================================================================
UI_HOST=0.0.0.0
UI_PORT=8000
# Comma-separated list of allowed CORS origins for the FastAPI server
UI_CORS_ORIGINS=http://localhost:3000

# =============================================================================
# Authentication / multi-tenancy (see docs/architecture/MULTI_TENANCY_PLAN.md)
# =============================================================================
# LOCAL DEVELOPMENT ONLY. When true, every request resolves to a fixed local
# admin account and no login is required. Never set this on a reachable host.
MONITOR_AUTH_DISABLED=false
AUTH_SESSION_COOKIE=monitor_session
AUTH_CSRF_COOKIE=monitor_csrf
AUTH_CSRF_HEADER=X-CSRF-Token
# Bounded browser-session lifetime in hours
AUTH_SESSION_TTL_HOURS=168
# Set to true/false to force the Secure cookie attribute; empty = automatic
# (secure unless MONITOR_AUTH_DISABLED=true)
AUTH_COOKIE_SECURE=
# Comma-separated client IPs of reverse proxies trusted for X-Forwarded-For
AUTH_TRUSTED_PROXIES=
# Login attempts allowed per AUTH_RATE_WINDOW_SECONDS per login+client IP
AUTH_LOGIN_RATE_LIMIT=5
AUTH_RATE_WINDOW_SECONDS=60
# Signup attempts allowed per AUTH_RATE_WINDOW_SECONDS per client IP
AUTH_SIGNUP_RATE_LIMIT=20
# Server-side maximum lifetime for API tokens (client-supplied expiry is clamped)
API_TOKEN_MAX_TTL_DAYS=365

# Google OAuth sign-in (optional — leave unset to disable the Google button).
# Register GOOGLE_OAUTH_REDIRECT_URI in the Google Cloud console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/oauth/google/callback
# Where the browser lands after a successful OAuth callback
AUTH_FRONTEND_URL=http://localhost:3000
OAUTH_STATE_COOKIE=monitor_oauth_state
OAUTH_STATE_TTL_SECONDS=600

# =============================================================================
# Core database credentials (used by infra/docker-compose.yml)
# =============================================================================
NEO4J_PASSWORD=changeme-neo4j
MONGODB_PASSWORD=changeme-mongodb
MINIO_PASSWORD=changeme-minio
POSTGRES_PASSWORD=changeme-postgres
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Pydantic Settings does NOT expand ${VAR}; hardcode the password here.
# When changing MONGODB_PASSWORD, update this URI in lockstep.
MONGODB_URI=mongodb://monitor:changeme-mongodb@localhost:27017/monitor?authSource=admin
QDRANT_URI=http://localhost:6333
# Storage backend selector:
#   minio  = local MinIO or any S3-compatible service via MINIO_* / STORAGE_ENDPOINT
#   s3     = AWS S3 (leave STORAGE_ENDPOINT blank for AWS)
#   folder = store uploaded files directly on disk
STORAGE_BACKEND=minio
STORAGE_ENDPOINT=
STORAGE_FALLBACK_TO_LOCAL=true
LOCAL_STORAGE_PATH=.local_storage

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=monitor
MINIO_SECRET_KEY=${MINIO_PASSWORD}
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=monitor
POSTGRES_DB=monitor
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
REDIS_KEY_PREFIX=monitor

# =============================================================================
# MCP server configuration
# =============================================================================
MCP_SERVER_PORT=8080
MCP_AUTH_SECRET=replace-with-random-secret

# =============================================================================
# Performance tuning
# =============================================================================
NEO4J_HEAP_INITIAL=512m
NEO4J_HEAP_MAX=2G
NEO4J_PAGECACHE=1G
MONGODB_CACHE_SIZE=1024
QDRANT_M=16
QDRANT_EF_CONSTRUCT=100

# =============================================================================
# LLM + embedding configuration
# =============================================================================
# LLM_PROVIDER is intentionally NOT set here — the runtime resolves provider
# from the `llm_providers` PostgreSQL table (seeded by `monitor init` or the
# scripts/seed_*_provider.py scripts). See docs/architecture/LLM_REGISTRY.md.
# Provider API keys in that table are encrypted at rest when this is set to a
# url-safe base64 32-byte Fernet key (generate one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ). Unset means keys are stored in plaintext and the data layer warns once.
# Keys written before this was set stay plaintext until re-saved (e.g. via the
# /config page while the stack is up).
MONITOR_PROVIDER_KEY_ENCRYPTION_KEY=
LLM_MODEL=claude-sonnet-4-20250514
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# GitHub Models (PAT with models:read scope — any of these three is accepted)
GITHUB_MODELS_TOKEN=
# GITHUB_TOKEN=
# GH_TOKEN=
GITHUB_MODELS_BASE_URL=https://models.github.ai/inference
GITHUB_MODELS_MODEL=gpt-4.1-mini

# Google AI Studio (Gemini)
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# Z.AI (ZhipuAI)
# Leave empty unless you have a real key: a non-empty placeholder makes the
# backend seed a Z.AI provider row that can never authenticate.
Z_AI_API_KEY=
Z_AI_MODEL=glm-5.1
Z_AI_BASE_URL=https://api.z.ai/api/coding/paas/v4

# MiniMax AI
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/anthropic

# Local Ollama
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text:latest
EMBEDDING_DIMENSION=768
EMBEDDING_BASE_URL=http://localhost:11434
# Vision model for image ingestion (must support image_url content)
# Options: gpt-4o-mini, gpt-4o, claude-3-5-sonnet-20241022, gemini/gemini-1.5-flash
VISION_MODEL=gpt-4o-mini

# =============================================================================
# Ingestion queue tuning
# =============================================================================
# Keep at 1 unless you have measured that your machine and LLM provider can
# safely handle parallel ingestion.
MONITOR_INGEST_MAX_WORKERS=1
MONITOR_INGEST_TIMEOUT=2700
MONITOR_MAX_INGEST_FILE_BYTES=209715200
REDIS_CACHE_TTL_SECONDS=30
REDIS_SOLO_PLAY_TTL_SECONDS=15
REDIS_SOCKET_TIMEOUT=0.15
REDIS_CONNECT_TIMEOUT=0.15

# =============================================================================
# Observability + flags
# =============================================================================
LOG_LEVEL=INFO
ENABLE_METRICS=true
METRICS_ENDPOINT=http://prometheus:9090
ENVIRONMENT=development
DEBUG=false
ENABLE_CORS=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# =============================================================================
# NLP / GLiNER (Named Entity Recognition)
# =============================================================================
NLP_ENABLED=true
# Default to spaCy (bundled, fast). Set to gliner to use the self-built GLiNER
# image (docker compose --profile gliner up) for zero-shot NER with custom
# labels; if the service is down, tools fall back to spaCy automatically.
NLP_BACKEND=spacy
# Entity labels used for NER. Defaults are generic; for RPG base-world
# ingestion use domain labels, e.g.:
# ENTITY_TYPES=npc,faction,location,item,deity,spell,organization,event,concept
ENTITY_TYPES=person,location,organization,product,event,work_of_art,law,language,date,time,percent,money,quantity,ordinal,cardinal
GLINER_PORT=8082
GLINER_MODEL=urchade/gliner_base
GLINER_MAX_LENGTH=384
GLINER_BATCH_SIZE=8
GLINER_CPUS=2.0
GLINER_MEMORY=4G
ENTITY_EXTRACTION_ENABLED=true
ENTITY_TYPES=person,location,organization,product,event,work_of_art,law,language,date,time,percent,money,quantity,ordinal,cardinal

# ── Observability (T-044) ────────────────────────────────────
# Agent calls are traced with logfire (OpenTelemetry-compatible).
# Local-only by default. To export spans:
#   LOGFIRE_TOKEN=...                # send to logfire cloud, or
#   OTEL_EXPORTER_OTLP_ENDPOINT=...  # any OTLP collector (e.g. http://localhost:4318)
LOGFIRE_SEND_TO_LOGFIRE=false
#LOGFIRE_TOKEN=
#OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Docker networking ---
# When the backend runs in Docker and a provider row points at a service on
# the HOST (ollama http://localhost:11434, LM Studio, ...), rewrite localhost
# to this hostname. docker-compose sets this automatically; leave empty for
# bare-metal runs.
MONITOR_LOCALHOST_REWRITE=

# =============================================================================
# Image generation settings (Task 10 — defaults for the /api/image/settings UI)
# Mode: provider_default passes everything through; lines_and_veils blocks
# prompts that directly violate an active campaign's agreements_lines/veils.
# =============================================================================
IMAGE_MODERATION_MODE=provider_default
IMAGE_MAX_PER_SCENE=4
IMAGE_MAX_PER_CONVERSATION=8
IMAGE_MAX_PER_ACTOR_HOUR=12
IMAGE_SUGGESTIONS_ENABLED=true
# When set, PUT /api/image/settings requires the same value in the
# X-Monitor-Admin-Key header. Leave unset to keep the endpoint open
# for local dev (a structlog warning is emitted on every write).
IMAGE_SETTINGS_ADMIN_KEY=

# =============================================================================
# Audio capture (CF-10) — the transcription backend
# =============================================================================
# Audio is another input mode for the Session Recorder: a recording becomes a
# transcript, a transcript becomes capture entries. Two ways to wire it, both
# chosen by configuration rather than by code.
#
# 1. Hosted — register a provider with role='transcription' (the /config page
#    has a "Transcription" role tier). Any OpenAI-compatible audio endpoint
#    works: POST {base_url}/audio/transcriptions. That is OpenAI, Groq, Azure,
#    or a self-hosted gateway fronting your own models.
# 2. Local — a whisper.cpp (or faster-whisper) binary on this host. The command
#    is split on whitespace; {audio_path} is replaced with the recording and
#    the binary must print a JSON object with "text" and optional "segments"
#    on stdout. Nothing leaves the host.
#    Example: MONITOR_TRANSCRIPTION_COMMAND=whisper-cli -m {model_path} -f {audio_path} -oj
MONITOR_TRANSCRIPTION_COMMAND=
MONITOR_TRANSCRIPTION_MODEL_PATH=

# =============================================================================
# CanonKeeper contradiction checks (CF-5 / G08)
# =============================================================================
# One candidate per model call instead of a batch of fifteen. Measured on the
# per-class corpus: this shape meets every recall floor, the batched one does
# not. See docs/testing/canonkeeper_recall_measurement_2026-11-11.md.
CANONKEEPER_PER_CANDIDATE_CHECKS=true
# Narrow the canon context to the facts that bear on each candidate. Measured:
# it costs a class of contradictions, so it is off.
CANONKEEPER_FOCUSED_CONTEXT=false
# A proposal carrying a direct-contradiction flag cannot be accepted without an
# explicit override reason (the override is audited).
CANONKEEPER_REQUIRE_OVERRIDE_REASON=true
# Default hard-rejection mode for owners who have not set a preference of
# their own. Per-owner: set it in the owner's preferences under "canonkeeper".
CANONKEEPER_HARD_REJECTION_DEFAULT=false

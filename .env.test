# =============================================================================
# MONITOR — Hermetic test environment
# =============================================================================
# Used when running scripts/tools outside pytest in "no real services" mode:
#   set -a; source .env.test; set +a
# (Inside pytest, the repo-root conftest.py enforces these values directly;
# this file is documentation + a manual escape hatch, not the enforcement.)
# =============================================================================

ANTHROPIC_API_KEY=test-anthropic-key
OPENAI_API_KEY=test-openai-key
GOOGLE_API_KEY=test-google-key
GITHUB_MODELS_TOKEN=test-github-token

MONGODB_URI=mongodb://127.0.0.1:1/monitor_test?serverSelectionTimeoutMS=100
NEO4J_URI=bolt://127.0.0.1:1
NEO4J_USER=neo4j
NEO4J_PASSWORD=test-password
QDRANT_URI=http://127.0.0.1:1
QDRANT_URL=http://127.0.0.1:1
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=1
POSTGRES_USER=monitor
POSTGRES_PASSWORD=test-password
POSTGRES_DB=monitor_test
MINIO_ENDPOINT=127.0.0.1:1
MINIO_ACCESS_KEY=test-access
MINIO_SECRET_KEY=test-secret
OPENSEARCH_URI=http://127.0.0.1:1
REDIS_URL=redis://127.0.0.1:1/0
REDIS_ENABLED=false

NLP_ENABLED=false
LOGFIRE_SEND_TO_LOGFIRE=false
